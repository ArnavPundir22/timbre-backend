# Stage 1: Build the Phoenix release
FROM elixir:1.17.2-slim AS elixir-builder
RUN apt-get update -y && apt-get install -y build-essential git && apt-get clean -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app/api
RUN mix local.hex --force && mix local.rebar --force
ENV MIX_ENV="prod"
COPY api/mix.exs api/mix.lock ./
RUN mix deps.get --only prod
RUN mix deps.compile
COPY api/config ./config
COPY api/lib ./lib
COPY api/priv ./priv
RUN mix compile
RUN mix release

# Stage 2: Execution runner image
FROM debian:bookworm-slim
RUN apt-get update -y && apt-get install -y libsqlite3-0 openssl curl && apt-get clean -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=elixir-builder /app/api/_build/prod/rel/timbre ./
ENV PORT=10000
ENV DATABASE_PATH="/tmp/timbre.db"
ENV MIX_ENV="prod"
ENV PHX_SERVER="true"
RUN mkdir -p /tmp/timbre_uploads
EXPOSE 10000
CMD ["sh", "-c", "/app/bin/timbre eval 'Timbre.Release.migrate' && /app/bin/timbre start"]
